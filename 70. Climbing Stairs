class Solution {
    public int climbStairs(int n) {
        //Fibonacci Series
        int result = 0;
        int a = 0;
        int b = 1;
        for (int i=1;i<=n;i++) {
            result = a;
            result += b;
            int temp = a + b;
            a = b;
            b = temp;
        }
        return result;
    }
}