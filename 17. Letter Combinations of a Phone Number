class Solution {
     final Map<Character, char[]> keyboard = Map.of(
        '2', new char[] { 'a', 'b', 'c' },
        '3', new char[] { 'd', 'e', 'f' },
        '4', new char[] { 'g', 'h', 'i' },
        '5', new char[] { 'j', 'k', 'l' },
        '6', new char[] { 'm', 'n', 'o' },
        '7', new char[] { 'p', 'q', 'r', 's' },
        '8', new char[] { 't', 'u', 'v' },
        '9', new char[] { 'w', 'x', 'y', 'z' }
);

    public List<String> letterCombinations(String digits) {        
        List<String> resultList = new ArrayList<String>();
        boolean ind = false;
        char[] dArray = digits.toCharArray();
        for (char d: dArray) {
            char[] temp = keyboard.get(d);
            List<String> tempList = new ArrayList<>(resultList);
            resultList.clear();
            for (char t: temp) {
                if (!ind) {
                    resultList.add(String.valueOf(t));
                } else {
                    for (String t2: tempList) {
                        resultList.add(t2+String.valueOf(t));
                    }
                }
            }
            ind = true;
        }

        return resultList;
    }
}