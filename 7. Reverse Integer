class Solution {
    public int reverse(int x) {
        int reversed = 0;
        int sign = x < 0 ? -1 : 1;
        x = sign * x;
        while(x!=0) {
            int dig = x%10;
            if((Integer.MAX_VALUE -dig)/10 < reversed){
                return 0;
            }
            reversed = reversed *10 + dig;
            x = x /10;
        }
        return reversed*sign;
    }
}